# Canonical site origin — used for metadata, JSON-LD, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — xem hướng dẫn tạo dự án và lấy khoá ở supabase/README.md
# ---------------------------------------------------------------------------

# Website đọc dữ liệu bằng hai biến này. Cả hai đều được nhúng vào mã nguồn
# gửi xuống trình duyệt — đó là thiết kế của Supabase, an toàn vì RLS chỉ mở
# quyền SELECT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# KHOÁ TOÀN QUYỀN, bỏ qua mọi RLS. Chỉ dùng cho script nhập liệu chạy trên
# máy. Tuyệt đối không đổi tên thành NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Form báo giá và form "Gửi yêu cầu tìm hàng".
# Mỗi yêu cầu được LƯU vào bảng yeu_cau_bao_gia (supabase/migrations/0024) và
# hiện ở /admin/bao-gia. Có RESEND_API_KEY thì gửi thêm email về hộp thư công
# ty; không có thì chỉ nằm trong trang quản trị (admin phải vào xem).
#
# RESEND_API_KEY   lấy ở resend.com > API Keys
# RFQ_INBOX        hộp thư nhận yêu cầu
# RFQ_FROM         địa chỉ gửi; tên miền sau @ phải được xác minh ở Resend
#                  (thêm bản ghi DNS), nếu không Resend từ chối gửi
#
# Tệp đính kèm: khách tải thẳng lên bucket "rfq" (migration 0018 + 0024), admin
# tải về ở trang quản trị. Có SUPABASE_SERVICE_ROLE_KEY trên Vercel thì tệp
# được gắn luôn vào email; không có thì email chỉ ghi tên tệp.
RESEND_API_KEY=
RFQ_INBOX=sales@kimthanhdong.com
RFQ_FROM=Website Kim Thành Đông <website@kimthanhdong.com>
